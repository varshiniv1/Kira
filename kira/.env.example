# Copy this file to .env and fill in your keys.
# GOOGLE_API_KEY — get one at https://aistudio.google.com/apikey
# FAL_KEY — get one at https://fal.ai/dashboard

GOOGLE_API_KEY=
FAL_KEY=

# --- Server ---

# Port the server listens on (Cloud Run sets this automatically)
PORT=8080

# --- Twilio WhatsApp (optional) ---
# Without these, WhatsApp falls back to pull-based messaging.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# --- Cloud Run only (leave unset for local dev) ---

# GCS bucket for persisting memory.json across container restarts.
# Without this, memory.json is read/written on local disk, which does
# not survive Cloud Run scaling to zero.
GCS_BUCKET_NAME=

# Base64-encoded YouTube OAuth token JSON: base64 token.json
# Without this, upload_to_youtube() falls back to the local token.pickle.
YOUTUBE_TOKEN_JSON=

# --- Per-user content block routing ---
# Maps specific WhatsApp numbers to content blocks.
# Format: phone:block-id (comma-separated for multiple users)
# Users not in this map get the globally active block.
# USER_BLOCK_MAP=+919003065436:fascinating-history,+1XXXXXXXXXX:space-cosmos
